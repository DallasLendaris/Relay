{
  "name": "@relay/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Relay shared formats (Alert, CheckIn) and the OpenAPI contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi/relay.yaml -o src/generated/api.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "node scripts/lint-spec.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
