# Relay local mode (npm run local / npm run simulate). Every variable is optional.
# Copy to .env only if you want to keep settings; nothing reads .env automatically,
# so export them in your shell or put them in front of the command.

# Where alerts come from: "replay" (saved NWS response, offline) or "live" (api.weather.gov).
RELAY_FEED=replay
# How pushes go out: "log" (printed, nothing sent) or "expo" (Expo's push service, real phones).
RELAY_PUSH=log
# Saved feed for replay mode. Default: newest backend/dev-data/replay/recorded-*.json,
# else backend/dev-data/replay/constructed-sample.json.
RELAY_REPLAY_FILE=
# Optional Expo access token, only if your Expo project requires one for push.
EXPO_ACCESS_TOKEN=
# HTTP server for the API and the status page.
PORT=8787
HOST=0.0.0.0
# How often to poll the feed, in seconds (NWS minimum is 30).
RELAY_POLL_SECONDS=30
# Contact added to the User-Agent by npm run capture-nws (NWS asks for one).
NWS_CONTACT=
