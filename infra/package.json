{
  "name": "@relay/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "synth": "cdk synth -c stage=dev",
    "seed-keys": "tsx scripts/seed-keys.ts",
    "oidc-roles": "cdk --app \"npx tsx bootstrap/app.ts\" --output bootstrap/cdk.out",
    "presynth": "npm run build -w @relay/shared",
    "pretest": "npm run build -w @relay/shared",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=60000"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.200.0",
    "cdk-nag": "2.38.2",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
